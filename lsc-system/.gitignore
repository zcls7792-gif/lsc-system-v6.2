# ==============================================================
# 链盛通 LSC V6.2-AI · GitLab 凭据安全防护 & 本地产物忽略
# ==============================================================

# -------- 凭据文件（绝对禁止提交） --------
.gitlab-ci.env
.env.gitlab
.credentials
*.pem
*.key
id_rsa*

# -------- 覆盖率产物（每次构建重新生成，不入库） --------
coverage/
覆盖率报告_*.html

# -------- CI step logs（按提交哈希归档，本地可清理） --------
logs/

# -------- 交付总结报告（每次生成，便于追溯但不强制入库；如需留存改 PR 策略单独提交） --------
开发总结报告_*.html
端到端交付总结_*.html

# -------- Node --------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------- Editor / OS --------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
