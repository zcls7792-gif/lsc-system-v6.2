{
  "name": "lsc-system",
  "version": "1.0.0",
  "description": "链盛通LSC消费权益凭证循环系统 V6.2-AI增强版",
  "scripts": {
    "test": "node verify_p0.js && node test_p0_chart_logic.js",
    "test:verify": "node verify_p0.js",
    "test:chart": "node test_p0_chart_logic.js",
    "coverage": "c8 --reports-dir=${C8_REPORT_DIR:-coverage} --reporter=html --reporter=text --reporter=lcov --reporter=text-summary --include=\"shared/**/*.js\" --include=\"platform-admin/**/*.js\" --include=\"merchant-admin/**/*.js\" --include=\"mobile-app/**/*.js\" --include=\"mini-program/**/*.js\" --exclude=\"node_modules/**\" --exclude=\"verify_p0.js\" --exclude=\"test_p0_chart_logic.js\" --exclude=\"coverage_runner.js\" --exclude=\"coverage_report.js\" --exclude=\"run-all.js\" --exclude=\"coverage/**\" node coverage_runner.js",
    "coverage:all": "c8 --reports-dir=${C8_REPORT_DIR:-coverage} --reporter=html --reporter=text --reporter=lcov --reporter=text-summary --include=\"shared/**/*.js\" --include=\"platform-admin/**/*.js\" --include=\"merchant-admin/**/*.js\" --include=\"mobile-app/**/*.js\" --include=\"mini-program/**/*.js\" --exclude=\"node_modules/**\" --exclude=\"verify_p0.js\" --exclude=\"test_p0_chart_logic.js\" --exclude=\"coverage_runner.js\" --exclude=\"coverage_report.js\" --exclude=\"run-all.js\" --exclude=\"coverage/**\" node verify_p0.js && node test_p0_chart_logic.js",
    "report": "node coverage_report.js",
    "all": "node run-all.js",
    "ci": "node run-all.js",
    "e2e": "npx playwright test --project=chromium-headless",
    "e2e:ui": "npx playwright test --project=chromium-headless --headed",
    "e2e:report": "npx playwright show-report e2e-report",
    "e2e:install": "npx playwright install chromium --with-deps",
    "audit:a11y": "node audit-a11y-baseline.js",
    "audit:a11y:static": "node audit-a11y-static.js",
    "audit:a11y:install": "npx playwright install chromium --with-deps || npx playwright install chromium",
    "audit:a11y:diff": "node audit-a11y-diff.js",
    "audit:a11y:ci": "node audit-a11y-baseline.js --strict && node audit-a11y-diff.js",
    "audit:a11y:baseline-save": "cp -f audit-report/a11y-baseline.json audit-report/a11y-baseline.baseline.json",
    "perf:baseline": "node scripts/run-lighthouse.js",
    "perf:baseline:mobile": "node scripts/run-lighthouse.js --mobile",
    "perf:baseline:ci": "node scripts/run-lighthouse.js --thresholds",
    "coverage:cobertura": "node lcov-to-cobertura.js",
    "audit:meta": "node audit-meta.js",
    "audit:meta:ci": "node audit-meta.js --strict --json audit-report/meta-audit.json --md audit-report/meta-audit.md",
    "audit:assets": "node audit-assets.js --json audit-report/assets-audit.json --md audit-report/assets-audit.md",
    "audit:assets:ci": "node audit-assets.js --strict --json audit-report/assets-audit.json --md audit-report/assets-audit.md",
    "all:hard": "npm run ci && npm run e2e && npm run audit:a11y && npm run audit:meta:ci && npm run audit:assets:ci"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "c8": {
    "checkCoverage": false,
    "reportDir": "coverage",
    "extension": [
      ".js"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "dependencies": {
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "c8": "^12.0.0",
    "node-static": "^0.7.11",
    "playwright": "^1.62.1"
  }
}
