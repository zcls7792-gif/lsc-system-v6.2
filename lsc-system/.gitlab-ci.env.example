# ==========================================================================
# GitLab 凭据 & 项目定位模板（复制本文件为 .gitlab-ci.env 后填入真实值）
# --------------------------------------------------------------------------
#  ⚠  安全规则（严格遵守，违者 Token 泄露自负）：
#    1. 本文件 .gitlab-ci.env 已被 .gitignore 忽略，永不要改名或手改 gitignore
#    2. Token 最小权限：仅 read_api scope（7 天过期 PAT 或 Project Access Token）
#    3. 永远不要把 Token 贴在对话框/邮件/即时通讯里；也不要 cp 到 coverage/ logs/
#    4. 在沙箱内通过：  source ./scripts/gitlab_ci_auth_setup.sh   加载
# ==========================================================================

# -------- ① GitLab 服务地址 --------
# 官方 SaaS：保持 https://gitlab.com
# 自建部署：填写 https://gitlab.<你的公司域名>.com  (不要以 / 结尾)
GITLAB_HOST="https://gitlab.com"

# -------- ② 项目定位（二选一，填完请把另一个注释掉） --------
# 方案 A：数字 Project ID  (✅ 推荐：Setting → General → Project ID 复制，无需 URL-encode)
GITLAB_PROJECT_ID=""

# 方案 B：namespace/project 路径 (例如：group-name/lsc-system-v6.2  注意如果路径含 / 必须正确填完整层级)
GITLAB_PROJECT=""

# -------- ③ Personal Access Token（最小权限 read_api）-------
# 生成入口：
#   SaaS  : https://gitlab.com/-/user_settings/personal_access_tokens
#   自建  : https://<你的 GitLab 域名>/-/user_settings/personal_access_tokens
# Scope: 只勾选 read_api   期限：7 天
GITLAB_TOKEN=""

# -------- ④ 审计开关（可选，开启后 checker 回显 scope 列表便于自查最小权限）--------
GITLAB_AUDIT_SCOPES=1
