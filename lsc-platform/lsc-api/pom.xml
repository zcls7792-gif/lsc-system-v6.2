<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zcls.lsc</groupId>
        <artifactId>lsc-platform-parent</artifactId>
        <version>7.7.2-SNAPSHOT</version>
    </parent>

    <artifactId>lsc-api</artifactId>
    <name>LSC API Layer</name>
    <description>第13章 REST接口+统一返回体+全局异常处理+42206-42301错误码映射</description>

    <dependencies>
        <dependency>
            <groupId>com.zcls.lsc</groupId>
            <artifactId>lsc-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zcls.lsc</groupId>
            <artifactId>lsc-order</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zcls.lsc</groupId>
            <artifactId>lsc-account</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zcls.lsc</groupId>
            <artifactId>lsc-coupon</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zcls.lsc</groupId>
            <artifactId>lsc-supplychain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zcls.lsc</groupId>
            <artifactId>lsc-risk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zcls.lsc</groupId>
            <artifactId>lsc-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zcls.lsc</groupId>
            <artifactId>lsc-product</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zcls.lsc</groupId>
            <artifactId>lsc-user</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zcls.lsc.api.LscApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
