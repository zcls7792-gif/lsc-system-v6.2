# =============================================================================
# LSC Platform 环境变量示例
# =============================================================================
# 用法：
#   1) cp .env.example .env
#   2) 填入真实凭证（.env 已被 .gitignore 排除，不会被提交）
#   3) 启动时通过 IDE 运行配置 / docker / systemd 注入这些环境变量
#
# Spring Boot relaxed binding：环境变量下划线形式对应 application.yml 的
# wx.mp.app-id 等绑定（WX_MP_APP_ID → wx.mp.app-id）。

# ---- 微信小程序凭证（敏感，仅服务端使用，禁止下发前端） ----
# AppID：wx 开头 18 位字符
WX_MP_APP_ID=wxa1b2c3d4e5f6g7h8
# AppSecret：微信公众平台 → 开发 → 开发设置 → AppSecret
WX_MP_APP_SECRET=
# 消息推送校验 token（可选，配置消息推送时使用）
WX_MP_TOKEN=
# 消息加解密 AES 密钥（可选）
WX_MP_AES_KEY=

# ---- 数据库（生产环境请替换） ----
# MYSQL_URL=jdbc:mysql://localhost:3306/lsc?useSSL=false&serverTimezone=UTC&characterEncoding=utf8mb4
# MYSQL_USER=root
# MYSQL_PASSWORD=root
