# ============================================================
# 链盛通LSC系统 V6.2-AI - 环境变量模板
# ============================================================
# 用法:
#   1. 复制本文件为 .env:  cp docker/.env.example docker/.env
#   2. 填入真实密钥（.env 已在 .gitignore 中，不会提交）
#   3. docker-compose 会自动加载 .env 文件
#
# ⚠️ 安全要求:
#   - 禁止将填入真实密钥的 .env 提交到代码仓库
#   - 生产环境密钥须通过密钥管理系统(Vault/KMS/Sealed Secrets)注入
#   - 密钥须定期轮换（建议每 90 天）
#   - 使用 openssl rand 生成强随机密钥:
#       openssl rand -base64 48   # JWT/API Key
#       openssl rand -hex 24      # 数据库密码
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
MYSQL_DATABASE=lsc_system
MYSQL_APP_USER=lsc_app
MYSQL_APP_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ---- Redis 集群 ----
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=lsc_admin
RABBITMQ_DEFAULT_PASS=CHANGE_ME_TO_STRONG_PASSWORD

# ---- Nacos ----
NACOS_AUTH_IDENTITY_KEY=lsc_nacos
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_TO_STRONG_PASSWORD

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ---- XXL-JOB ----
XXL_JOB_ACCESS_TOKEN=CHANGE_ME_TO_STRONG_TOKEN

# ---- JWT (至少 32 字节) ----
JWT_ACCESS_SECRET=CHANGE_ME_use_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_use_openssl_rand_base64_48

# ---- 应用角色初始密码 ----
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
AUDITOR_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
OPERATOR_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ---- 区块链节点 ----
CHAIN_RPC_URL=http://chain-rpc:8545
CHAIN_CONTRACT=
CHAIN_PK=

# ---- AI 服务 ----
AI_API_KEY=
AI_ENDPOINT=

# ---- 对象存储 (OSS) ----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# ---- 服务 profile ----
SPRING_PROFILES_ACTIVE=prod
