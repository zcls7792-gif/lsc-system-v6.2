<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase L2：lsc-user-service logback 模板（字段与 order-service 一致，仅 APP_NAME 不同）。
  目的：统一 MDC 字段（traceId/grayPolicyId/grayVersion）→ Loki/ES 聚合错误率曲线
-->
<configuration scan="true" scanPeriod="30 seconds">

    <property name="LOG_HOME" value="${LOG_HOME:-/var/log/lsc/user-service}"/>
    <property name="APP_NAME" value="lsc-user-service"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>grayPolicyId</includeMdcKeyName>
            <includeMdcKeyName>grayVersion</includeMdcKeyName>
            <customFields>{"app":"${APP_NAME}","version":"6.2.0"}</customFields>
        </encoder>
    </appender>

    <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/history/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>200MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>grayPolicyId</includeMdcKeyName>
            <includeMdcKeyName>grayVersion</includeMdcKeyName>
            <customFields>{"app":"${APP_NAME}"}</customFields>
        </encoder>
    </appender>

    <logger name="com.lianshengtong" level="${LOG_LEVEL_COM_LIANSHENGTONG:-INFO}" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ROLLING"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ROLLING"/>
    </root>
</configuration>
